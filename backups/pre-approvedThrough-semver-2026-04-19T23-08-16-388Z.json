  {
    "id": "zrrt51fgmn578ujz",
    "name": "Thrivor",
    "data": {
      "qaOwner": "",
      "repoUrl": "toomesauce/thrivor",
      "autonomy": {
        "cadence": "weekly",
        "enabled": true,
        "autoAdvance": true,
        "approvalMode": "per-major",
        "lastProposal": {
          "tasks": [
            {
              "title": "Test challenge CRUD flow E2E",
              "impact": "Validates core gamification loop — create ladder, add challenge, complete, earn points, badge"
            },
            {
              "title": "Test reward/redemption flow E2E",
              "impact": "Validates parent creates reward, child redeems, parent approves — proves co-parenting model"
            },
            {
              "title": "Test journal flow E2E",
              "impact": "Validates free text, prompted entries, mood tracking, and trend view — core child engagement"
            },
            {
              "title": "Build therapist dashboard pages",
              "impact": "Registration, patient list, reports — therapists have no entry point without this"
            },
            {
              "title": "Build therapist scene builder UI",
              "impact": "Frontend for simulation scene builder API — lets therapists author custom scenarios"
            },
            {
              "title": "Parent-child switcher UI",
              "impact": "Essential UX for dual-user model — parents and children share device, need separate views"
            },
            {
              "title": "Mobile viewport testing",
              "impact": "Primary audience is families on phones/tablets — must work on mobile"
            },
            {
              "title": "PDF progress report export",
              "impact": "Tangible deliverable therapists hand to parents or attach to clinical notes"
            }
          ],
          "version": "0.902",
          "rationale": "v0.9015 hardened the backend. v0.902 closes the frontend loop: wire up remaining UIs, validate every core flow E2E, and make the app demo-ready on mobile. Answers: Can a parent, child, and therapist actually use Thrivor together?",
