# Org Studio Configuration
# The server binds to loopback by default. Set this only when exposing Org
# Studio through a trusted network or authenticated reverse proxy.
# ORG_STUDIO_HOST=127.0.0.1

# PostgreSQL (for remote access + multi-instance sync)
# DATABASE_URL=postgresql://user:pass@host:5432/org_studio_db?sslmode=require

# Workspace membership enforcement. Defaults to strict when DATABASE_URL is
# configured and permissive in single-workspace file mode.
# WORKSPACE_ENFORCE=strict

# API key for browser/API access. Required for any non-loopback deployment.
# Org Studio does NOT auto-generate or persist this value.
# ORG_STUDIO_API_KEY=your-secret-key

# Emergency escape hatch for an intentionally isolated trusted network.
# Never enable on an internet-reachable host.
# ALLOW_INSECURE_REMOTE=false

# Admin endpoint auth (#1508). Either one or both can be set.
# ORG_STUDIO_ADMIN_API_KEY=<dedicated bearer for scripting admin queries; separate from ORG_STUDIO_API_KEY>
# ORG_STUDIO_ADMIN_USER_IDS=basil,henry  # comma-separated session userIds allowed to call admin endpoints

# OpenClaw Gateway
# GATEWAY_URL=ws://127.0.0.1:18789
# GATEWAY_TOKEN=your-gateway-token

# Hermes Agent (auto-detected if ~/.hermes exists; set URL to override)
# HERMES_URL=http://127.0.0.1:8642

# Telegram notifications (optional)
# VISION_TOPIC_GROUP_ID=
# VISION_TOPIC_BOT_TOKEN=

# Telegram notifications (task status, version completions)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Telegram comms relay (v0.15: disabled by default)
# Set to 'true' to re-enable task updates, mentions, comments via Telegram
# ENABLE_TELEGRAM_COMMS=false

# Health alerts — independent of comms relay
# TELEGRAM_HEALTH_BOT_TOKEN=your-health-bot-token
# TELEGRAM_HEALTH_CHAT_ID=your-health-chat-id
# TELEGRAM_HEALTH_ALERTS_WEBHOOK_URL=https://your-webhook.example.com/health
# TELEGRAM_HEALTH_ALERTS_WEBHOOK_SECRET=replace-with-random-shared-secret  # inbound auth for /api/webhooks/health-alerts
